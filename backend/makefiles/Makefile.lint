# vim: set ft=make:
.PHONY: all clean test

.PHONY: lint
lint: format-setup lint-golang lint-yaml

.PHONY: lint-fix
lint-fix: format-setup lint-golang-fix lint-yaml-fix

.PHONY: lint-golang
lint-golang: lint-setup
	@echo "Linting `echo $(GOLANG_SOURCES) | tr ' ' '\n' | wc -l` .go files..."
	@golangci-lint run --timeout 10m --allow-parallel-runners
	@echo "✅ No golang lint errors found."

.PHONY: lint-golang-fix
lint-golang-fix: lint-setup
	@echo "Fixing golang lint errors..."
	@golangci-lint run --timeout 10m --allow-parallel-runners --fix
	@echo "✅ Golang lint errors fixed."

.PHONY: lint-yaml
lint-yaml: lint-setup
	@echo "Linting `echo $(YAML_SOURCES) | tr ' ' '\n' | wc -l` .yaml files..."
	@yamllint $(YAML_SOURCES)
	@echo "✅ No yaml lint errors found."

.PHONY: lint-yaml-fix
lint-yaml-fix: lint-setup
	@echo "Fixing yaml lint errors..."
	@yamlfix $(YAML_SOURCES)
	@echo "✅ Yaml lint errors fixed."

.PHONY: lint-setup
lint-setup:
	@./scripts/ci/setup-linting.sh

.PHONY: lint-breaking
lint-breaking: lint-breaking-protos
