// ConvertRuleMetadataToStoreRule converts RuleMetadata to sql-reviewer types.SQLReviewRule
func ConvertRuleMetadataToStoreRule(metadata RuleMetadata, level models.SQLReviewRuleLevel, payload map[string]interface{}) *types.SQLReviewRule {
	rule := &types.SQLReviewRule{
		Type:   metadata.Type,
		Level:  convertLevelToStoreLevel(level),
		Engine: convertDatabaseTypeToEngine(metadata.Engine),
	}

	if payload != nil {
		rule.Payload = payload
	} else if metadata.Parameters != nil {
		rule.Payload = metadata.Parameters
	}

	return rule
}

// convertLevelToStoreLevel converts SQLReviewRuleLevel to types.SQLReviewRuleLevel
func convertLevelToStoreLevel(level models.SQLReviewRuleLevel) types.SQLReviewRuleLevel {
	switch level {
	case models.SQLReviewRuleLevelError:
		return types.SQLReviewRuleLevel_ERROR
	case models.SQLReviewRuleLevelWarning:
		return types.SQLReviewRuleLevel_WARNING
	default:
		return types.SQLReviewRuleLevel_WARNING
	}
}

// convertDatabaseTypeToEngine converts models.DatabaseType to types.Engine
func convertDatabaseTypeToEngine(dbType models.DatabaseType) types.Engine {
	switch dbType {
	case models.DatabaseTypeMySQL:
		return types.Engine_MYSQL
	case models.DatabaseTypePostgreSQL:
		return types.Engine_POSTGRES
	default:
		return types.Engine_MYSQL
	}
}
