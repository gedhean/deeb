package review

import (
	"github.com/nsxbet/deeb/internal/models"
	"github.com/nsxbet/sql-reviewer/pkg/types"
)

// RuleCategory represents a category of SQL review rules
type RuleCategory string

const (
	RuleCategoryEngine    RuleCategory = "Engine"
	RuleCategoryNaming    RuleCategory = "Naming"
	RuleCategoryTable     RuleCategory = "Table"
	RuleCategoryColumn    RuleCategory = "Column"
	RuleCategorySystem    RuleCategory = "System"
	RuleCategoryIndex     RuleCategory = "Index"
	RuleCategorySchema    RuleCategory = "Schema"
	RuleCategoryStatement RuleCategory = "Statement"
)

// RuleMetadata represents metadata about a SQL review rule
type RuleMetadata struct {
	Type        string                 `json:"type"`
	Name        string                 `json:"name"`
	Description string                 `json:"description"`
	Category    RuleCategory           `json:"category"`
	Engine      models.DatabaseType    `json:"engine"`
	Parameters  map[string]interface{} `json:"parameters,omitempty"`
}

// GetAvailableRules returns all available rules for MySQL and PostgreSQL
func GetAvailableRules() map[models.DatabaseType]map[RuleCategory][]RuleMetadata {
	rules := make(map[models.DatabaseType]map[RuleCategory][]RuleMetadata)

	// MySQL rules
	mysqlRules := make(map[RuleCategory][]RuleMetadata)
	mysqlRules[RuleCategoryEngine] = getMySQLEngineRules()
	mysqlRules[RuleCategoryNaming] = getMySQLNamingRules()
	mysqlRules[RuleCategoryTable] = getMySQLTableRules()
	mysqlRules[RuleCategoryColumn] = getMySQLColumnRules()
	mysqlRules[RuleCategoryIndex] = getMySQLIndexRules()
	mysqlRules[RuleCategoryStatement] = getMySQLStatementRules()
	rules[models.DatabaseTypeMySQL] = mysqlRules

	// PostgreSQL rules
	postgresRules := make(map[RuleCategory][]RuleMetadata)
	postgresRules[RuleCategoryEngine] = getPostgresEngineRules()
	postgresRules[RuleCategoryNaming] = getPostgresNamingRules()
	postgresRules[RuleCategoryTable] = getPostgresTableRules()
	postgresRules[RuleCategoryColumn] = getPostgresColumnRules()
	postgresRules[RuleCategoryIndex] = getPostgresIndexRules()
	postgresRules[RuleCategoryStatement] = getPostgresStatementRules()
	rules[models.DatabaseTypePostgreSQL] = postgresRules

	return rules
}

// GetRulesByEngine returns rules for a specific engine
func GetRulesByEngine(engine models.DatabaseType) map[RuleCategory][]RuleMetadata {
	allRules := GetAvailableRules()
	return allRules[engine]
}

// getMySQLEngineRules returns MySQL engine rules
func getMySQLEngineRules() []RuleMetadata {
	return []RuleMetadata{
		{
			Type:        "mysql.engine.no-select-all",
			Name:        "No SELECT *",
			Description: "Disallow SELECT * in queries",
			Category:    RuleCategoryEngine,
			Engine:      models.DatabaseTypeMySQL,
		},
		{
			Type:        "mysql.engine.use-index",
			Name:        "Use Index",
			Description: "Require indexes for WHERE clauses",
			Category:    RuleCategoryEngine,
			Engine:      models.DatabaseTypeMySQL,
		},
		{
			Type:        "mysql.engine.table-no-fk",
			Name:        "Table No Foreign Key",
			Description: "Disallow foreign keys in tables",
			Category:    RuleCategoryEngine,
			Engine:      models.DatabaseTypeMySQL,
		},
	}
}

// getMySQLNamingRules returns MySQL naming rules
func getMySQLNamingRules() []RuleMetadata {
	return []RuleMetadata{
		{
			Type:        "mysql.naming.table",
			Name:        "Table Naming Convention",
			Description: "Enforce table naming conventions",
			Category:    RuleCategoryNaming,
			Engine:      models.DatabaseTypeMySQL,
			Parameters: map[string]interface{}{
				"max_length": 64,
			},
		},
		{
			Type:        "mysql.naming.column",
			Name:        "Column Naming Convention",
			Description: "Enforce column naming conventions",
			Category:    RuleCategoryNaming,
			Engine:      models.DatabaseTypeMySQL,
			Parameters: map[string]interface{}{
				"max_length": 64,
			},
		},
		{
			Type:        "mysql.naming.id",
			Name:        "ID Naming Convention",
			Description: "Enforce ID column naming conventions",
			Category:    RuleCategoryNaming,
			Engine:      models.DatabaseTypeMySQL,
		},
	}
}

