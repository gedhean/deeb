# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# Database Configuration
# Option 1: Use DATABASE_URL (PostgreSQL connection string)
DATABASE_URL=postgres://deeb:password@localhost:5432/deeb_metadata?sslmode=disable

# Option 2: Use individual database environment variables (override DATABASE_URL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=deeb
DB_PASSWORD=your-secure-password-here
DB_NAME=deeb_metadata
DB_SSLMODE=disable

# Authentication Configuration
# JWT_SECRET must be at least 32 characters long
JWT_SECRET=your-jwt-secret-key-minimum-32-characters-long-change-this-in-production

# OAuth 2.0 Configuration (Optional)
# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# GitHub OAuth (Not yet implemented)
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# OAuth Callback URL
AUTH_CALLBACK_URL=http://localhost:8080/api/v1/auth/google/callback

# Two-Factor Authentication
# Set to "true" to require 2FA for all users
REQUIRE_2FA=false

# Security Configuration
# ENCRYPTION_KEY must be exactly 32 characters (256 bits)
ENCRYPTION_KEY=12345678901234567890123456789012

# Bcrypt cost for password hashing (10-31, higher is more secure but slower)
BCRYPT_COST=12

# Logging Configuration
# LOG_LEVEL: debug, info, warn, error
LOG_LEVEL=info

# LOG_FORMAT: json, console
LOG_FORMAT=json

# Application Version (set automatically by build)
APP_VERSION=0.1.0
