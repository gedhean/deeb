# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# Database Configuration
# Option 1: Use DATABASE_URL (PostgreSQL connection string)
DATABASE_URL="postgres://deeb:password@localhost:5432/deeb?sslmode=disable"

# Authentication Configuration
# JWT_SECRET must be at least 32 characters long
JWT_SECRET=sJbRHqgobZq4mdNuStTYXBQZ1Wd82YJX

# OAuth 2.0 Configuration (Optional)
# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# GitHub OAuth (Not yet implemented)
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# OAuth Callback URL
AUTH_CALLBACK_URL=http://localhost:8080/api/v1/auth/google/callback

# Two-Factor Authentication
# Set to "true" to require 2FA for all users
REQUIRE_2FA=false

# Security Configuration
# ENCRYPTION_KEY must be exactly 32 characters (256 bits)
ENCRYPTION_KEY=ASwCQO2LQUs2COfOcpBZoMBJuLvDI4XR

# Bcrypt cost for password hashing (10-31, higher is more secure but slower)
BCRYPT_COST=12

# Logging Configuration
# LOG_LEVEL: debug, info, warn, error
LOG_LEVEL=debug

# LOG_FORMAT: json, console
LOG_FORMAT=console

# Application Version (set automatically by build)
APP_VERSION=0.1.0
