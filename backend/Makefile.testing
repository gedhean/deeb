.PHONY: help test test-verbose test-coverage clean build run migrate-up migrate-down lint fmt

# Default target
help:
	@echo "Available targets:"
	@echo "  test           - Run tests using gotestsum"
	@echo "  test-verbose   - Run tests with verbose output"
	@echo "  test-coverage  - Run tests with coverage report"
	@echo "  clean          - Remove build artifacts"
	@echo "  build          - Build the server binary"
	@echo "  run            - Run the server"
	@echo "  migrate-up     - Run database migrations up"
	@echo "  migrate-down   - Run database migrations down"
	@echo "  lint           - Run golangci-lint"
	@echo "  fmt            - Format code with gofmt"

# Install gotestsum if not present
ensure-gotestsum:
	@which gotestsum > /dev/null || (echo "Installing gotestsum..." && go install gotest.tools/gotestsum@latest)

# Run tests using gotestsum
test: ensure-gotestsum
	@gotestsum --format testname -- -race ./...

# Run tests with verbose output
test-verbose: ensure-gotestsum
	@gotestsum --format standard-verbose -- -race -v ./...

# Run tests with coverage
test-coverage: ensure-gotestsum
	@gotestsum --format testname -- -race -coverprofile=coverage.out -covermode=atomic ./...
	@go tool cover -html=coverage.out -o coverage.html
	@echo "Coverage report generated: coverage.html"

