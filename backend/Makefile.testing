.PHONY: test test-verbose test-coverage test-integration

# Install gotestsum if not present
ensure-gotestsum:
	@which gotestsum > /dev/null || (echo "Installing gotestsum..." && go install gotest.tools/gotestsum@latest)

# Run tests using gotestsum with parallel execution
# -p=4 runs up to 4 packages in parallel
test: ensure-gotestsum
	@gotestsum --format testname -- -race -p=4 ./...

# Run integration tests with testcontainers
test-integration: ensure-gotestsum
	@echo "Running integration tests with testcontainers..."
	@TESTCONTAINERS_RYUK_DISABLED=true gotestsum --format testname -- -v -tags=integration -timeout=5m ./internal/handlers/

# Run tests with verbose output
test-verbose: ensure-gotestsum
	@gotestsum --format standard-verbose -- -race -v ./...

# Run tests with coverage
test-coverage: ensure-gotestsum
	@gotestsum --format testname -- -race -coverprofile=coverage.out -covermode=atomic ./...
	@go tool cover -html=coverage.out -o coverage.html
	@echo "Coverage report generated: coverage.html"

